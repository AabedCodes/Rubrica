# Copy to .env only for values that are NOT secrets. Secrets live in secrets/
# (created by `make secrets`) and reach containers as Docker secrets.
# Every variable the stack reads is listed here, with no values.

# --- General ---
RUBRICA_ENV=
LOG_LEVEL=
WEB_PORT=
MAILPIT_UI_PORT=

# --- Database (passwords come from secrets/db_<role>_password) ---
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Model adapter (01-interfaces.md §6) ---
LLM_PROVIDER=
LLM_MODEL_ORCHESTRATOR=
LLM_MODEL_GRADER=
LLM_MODEL_CHECKER=
LLM_MODEL_CHAT=
LLM_MODEL_INSTRUCTOR=
LLM_MAX_OUTPUT_TOKENS_ORCHESTRATOR=
LLM_MAX_OUTPUT_TOKENS_GRADER=
LLM_MAX_OUTPUT_TOKENS_CHECKER=
LLM_MAX_OUTPUT_TOKENS_CHAT=
LLM_MAX_OUTPUT_TOKENS_INSTRUCTOR=
LLM_BUDGET_USD_DAILY=
# Host the llm-proxy allows CONNECT to (empty = deny all until keys arrive)
LLM_PROVIDER_HOST=

# --- Email ---
SMTP_HOST=
SMTP_PORT=
OPS_ALERT_ADDRESS=

# --- Embeddings ---
EMBEDDING_MODEL=
EMBEDDING_MODEL_REVISION=
