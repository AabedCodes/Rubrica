# npm supply-chain hardening (A1, C14, T-16). See docs/plan/A-product-owner.md A1.
# No package may run install scripts on a developer machine, in CI or in Docker.
ignore-scripts=true
# Every dependency is pinned to an exact version in package.json.
save-exact=true
fund=false
# Refuse to install on an engine that package.json does not allow (Node 22).
engine-strict=true
