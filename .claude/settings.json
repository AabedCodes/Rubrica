{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./backend/uv.lock)",
      "Edit(./frontend/package-lock.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(uv publish *)"
    ],
    "ask": [
      "Edit(./.github/workflows/**)",
      "Edit(./prompts/**)",
      "Edit(./backend/mcp_server/tools.py)",
      "Edit(./backend/mcp_server/descriptions.py)",
      "Edit(./01-interfaces.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Bash(uv add *)",
      "Bash(npm install *)"
    ]
  }
}
